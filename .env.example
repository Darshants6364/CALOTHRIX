# CALOTHRIX Environment Variables (copy to .env and fill in values)

# Server runtime
PORT=3000
NODE_ENV=development
SUPPORT_EMAIL=privacy@calothrix.app

# Supabase (public client credentials)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only, never expose to client; required for permanent account deletion)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI (server-only)
GEMINI_API_KEY=

# External Nutrition APIs (server-only)
USDA_FDC_API_KEY=

# Server-only Admin fallback email list (comma-separated, optional; prefer Supabase app_metadata.role = 'admin')
ADMIN_EMAILS=